.venv/
venv/
__pycache__/
*.pyc
.env
*.egg-info/
.pytest_cache/

# macOS junk
.DS_Store

# run.sh service logs
.run-logs/

# Persistent per-operator global Knowledge Base — original uploaded bytes
kb_store/

# Locally-downloaded extra models (SD Turbo, MOMENT-1-small, etc.) — this
# machine's GPU-capacity downloads, not part of the committed contract/code.
extra_models/

# Server-side accounts: salted password hashes for whoever is deployed on
# that box. Per-deployment state, never source — and committing it would
# publish every operator's hash and freeze the "first account is admin"
# bootstrap at whatever the developer's machine happened to create.
app/audit/accounts.sqlite3

# Runtime audit DB — rewritten on every task; tracking it caused a merge
# conflict on every git pull. Kept out of version control; each deployment
# builds its own from init_db().
app/audit/audit_log.sqlite3
